#!/bin/sh /etc/rc.common
# Indicator roles of Beam WRT, see /usr/libexec/be7000-leds. Starts after the
# led service (START=96) so its configuration is already applied.
START=97
USE_PROCD=1

start_service() {
	/usr/libexec/be7000-leds sync
	/usr/libexec/be7000-leds polled || return 0
	procd_open_instance
	procd_set_param command /usr/libexec/be7000-leds watch
	procd_set_param respawn 3600 10 5
	procd_close_instance
}

stop_service() {
	echo 0 > /sys/class/leds/white:aiot/brightness 2>/dev/null
}

service_triggers() {
	procd_add_reload_trigger be7000
}
