#!/bin/sh
# Indicator roles of Beam WRT that the stock LED page cannot express.
#
#   status         JSON for the LuCI page
#   aiot off       leave the white AIoT LED dark and unmanaged (the default)
#   sync           put the amber 2.4 GHz LED into /etc/config/system once,
#                  set the fixed AIoT mode
#   watch          keeps the AIoT LED in step with a polled source
#   polled         exit status 0 when the AIoT source needs watching
#   apply          restart the service after a change
#
# Everything the kernel can do by itself (netdev, timer, heartbeat, any other
# trigger) is set on the stock page System, LEDs, for every LED. This is for
# what needs looking at: a service, an address, a command. A LED that has an
# entry in /etc/config/system is left alone.
#
# What the AIoT LED shows (be7000.leds.aiot_source):
#   service    a process is running                 aiot_service
#   internet   a host answers a ping                aiot_target
#   command    a command exits with 0               aiot_cmd
#   off        not managed here                     (default)
# and how: aiot_show on|blink, aiot_invert 0|1, aiot_on_ms and aiot_off_ms
# for blinking.

AIOT=/sys/class/leds/white:aiot
AMBER=amber:network

opt() {
	uci -q get be7000.leds.$1
}

set_cfg() {
	[ -f /etc/config/be7000 ] || : > /etc/config/be7000
	uci -q get be7000.leds >/dev/null || uci set be7000.leds=leds
	uci set be7000.leds.$1="$2"
	uci commit be7000
}

used_by_user() {
	uci -q show system | grep -q "sysfs='$1'"
}

# The amber network LED shows Wi-Fi 2.4 GHz traffic by default. It is put into
# the stock LED configuration once and is the user's from then on: change or
# delete it on the page System, LEDs.
seed_wlan2g() {
	[ "$(opt wlan2g_seeded)" = 1 ] && return 0
	if ! uci -q get system.led_wlan2g >/dev/null && ! used_by_user $AMBER && [ -d /sys/class/leds/$AMBER ]; then
		uci set system.led_wlan2g=led
		uci set system.led_wlan2g.name='WIFI 2.4GHz'
		uci set system.led_wlan2g.sysfs="$AMBER"
		uci set system.led_wlan2g.trigger='netdev'
		uci set system.led_wlan2g.mode='tx rx'
		uci set system.led_wlan2g.dev='phy0-ap0'
		uci commit system
		/etc/init.d/led reload >/dev/null 2>&1
	fi
	set_cfg wlan2g_seeded 1
}

aiot_source() {
	local src
	src="$(opt aiot_source)"
	case "$src" in
	service|internet|command) echo "$src" ;;
	*) echo off ;;
	esac
}

polled() {
	case "$1" in service|internet|command) return 0 ;; esac
	return 1
}

led_off() {
	echo none > $AIOT/trigger 2>/dev/null
	echo 0 > $AIOT/brightness 2>/dev/null
}

led_on() {
	echo none > $AIOT/trigger 2>/dev/null
	echo 1 > $AIOT/brightness 2>/dev/null
}

led_blink() {
	echo timer > $AIOT/trigger 2>/dev/null
	echo "${1:-500}" > $AIOT/delay_on 2>/dev/null
	echo "${2:-500}" > $AIOT/delay_off 2>/dev/null
}

cond() {
	case "$1" in
	service) [ -n "$(opt aiot_service)" ] && pidof "$(opt aiot_service)" >/dev/null 2>&1 ;;
	internet) ping -c1 -W2 "$(opt aiot_target)" >/dev/null 2>&1 ;;
	command) [ -n "$(opt aiot_cmd)" ] && sh -c "$(opt aiot_cmd)" >/dev/null 2>&1 ;;
	esac
}

watch_aiot() {
	local src v want cur="" every=5
	[ -d $AIOT ] || exit 0
	used_by_user white:aiot && exit 0
	src="$(aiot_source)"
	if ! polled "$src"; then
		led_off
		exit 0
	fi
	[ "$src" = internet ] && every=15
	# leave at once when the service is stopped, not after the next sleep
	trap 'kill $! 2>/dev/null; exit 0' TERM INT
	while :; do
		cond "$src" && v=1 || v=0
		[ "$(opt aiot_invert)" = 1 ] && v=$((1 - v))
		if [ $v = 1 ]; then
			[ "$(opt aiot_show)" = blink ] && want=blink || want=on
		else
			want=off
		fi
		if [ "$want" != "$cur" ]; then
			case "$want" in
			on) led_on ;;
			blink) led_blink "$(opt aiot_on_ms)" "$(opt aiot_off_ms)" ;;
			*) led_off ;;
			esac
			cur="$want"
		fi
		sleep $every &
		wait $!
	done
}

case "$1" in
status)
	printf '{"aiot_on":%s,"aiot_busy":%s}\n' \
		$([ "$(cat $AIOT/brightness 2>/dev/null)" = 1 ] && echo true || echo false) \
		$(used_by_user white:aiot && echo true || echo false)
	;;
aiot)
	[ "$2" = off ] || { echo "usage: $0 aiot off (choose a source on the page System, LEDs)"; exit 1; }
	set_cfg aiot_source off
	/etc/init.d/be7000-leds restart >/dev/null 2>&1
	;;
sync)
	seed_wlan2g
	;;
watch)
	watch_aiot
	;;
polled)
	[ -d $AIOT ] && ! used_by_user white:aiot && polled "$(aiot_source)"
	;;
apply)
	/etc/init.d/be7000-leds restart >/dev/null 2>&1
	;;
*)
	echo "usage: $0 status | aiot off | sync | watch | polled | apply"
	exit 1
	;;
esac
