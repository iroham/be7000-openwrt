#!/usr/bin/ucode
// Builds /etc/banner: the stock OpenWrt banner from /rom plus the credits
// from the same JSON the LuCI page (System, Credits) shows.

import { readfile, writefile } from 'fs';

const src = readfile('/rom/etc/banner') ?? readfile('/etc/banner.openwrt') ?? '';
const data = json(readfile('/www/luci-static/resources/be7000-credits/credits.json') ?? '{}');
const rel = readfile('/etc/be7000-release') ?? '';
const ver = match(rel, /VERSION=([^\n]+)/)?.[1];

let out = src;
if (!match(out, /\n$/))
	out += '\n';

out += `\n be7000-openwrt${ver ? ' ' + ver : ''}\n\n Спасибо всем, без кого этой сборки бы не было\n`;

for (let g in data.groups ?? []) {
	out += `\n  ${g.title.ru}\n`;
	let rest = [];
	for (let p in g.people) {
		if (p.star)
			out += `    ${p.name}, на его плате нашлась причина мёртвого Ethernet\n`;
		else
			push(rest, p.name);
	}
	// wrap the plain names at about 72 columns
	let line = '    ';
	for (let i, n in rest) {
		let piece = n + (i < length(rest) - 1 ? ', ' : '');
		if (length(line) + length(piece) > 76) {
			out += rtrim(line) + '\n';
			line = '    ';
		}
		line += piece;
	}
	if (length(rest))
		out += line + '\n';
}

out += `\n Ссылки на всех в LuCI, Система, Благодарности\n ${replace(data.project ?? '', 'https://', '')}\n\n`;

writefile('/etc/banner', out);
