#!/bin/sh
# Move /overlay onto an external disk (extroot).
#
# Everything the router keeps between reboots lives in /overlay: installed
# packages, settings, lists. On this board the built-in space for it is small,
# so a USB disk is the way to get room.
#
# Usage:
#   be7000-extroot status
#   be7000-extroot list
#   be7000-extroot use <device> [--yes] [--reboot]
#   be7000-extroot revert [--yes] [--reboot]

set -e

LABEL=be7000_overlay
MNT=/tmp/extroot.$$

die() { echo "$*" >&2; exit 1; }

# fstools reads the extroot entry from the fstab in the slot's own rootfs_data
# volume, one level only. On this board /overlay normally lives on the shared
# volume on mtd28 (bigoverlay), so a plain `uci commit fstab` lands there and
# fstools never sees it. The entry has to go into rootfs_data as well.
rootfs_data_dev() {
	local n
	for n in /sys/class/ubi/ubi*_*/name; do
		[ -e "$n" ] || continue
		[ "$(cat "$n")" = rootfs_data ] && { echo "/dev/$(basename "$(dirname "$n")")"; return 0; }
	done
	return 1
}

# The shared settings volume on mtd28 (bigoverlay): stock's "cfg", else the
# legacy "overlay_data".
bigoverlay_dev() {
	local n want
	for want in cfg overlay_data; do
		for n in /sys/class/ubi/ubi1_*/name; do
			[ -e "$n" ] || continue
			[ "$(cat "$n")" = "$want" ] && { echo "/dev/$(basename "$(dirname "$n")")"; return 0; }
		done
	done
	return 1
}

# Run "uci -c <dir> batch" with stdin on the config dir of the overlay volume
# <dev>. When /overlay is that volume, it is the live /etc/config.
with_volume_config() {
	local dev="$1" dir mnt="" rc=0
	if [ "$dev" = "$(current_overlay_device)" ]; then
		uci -q batch
		return $?
	fi
	dir="$(mount | awk -v d="$dev" '$1 == d { print $3; exit }')"
	if [ -z "$dir" ]; then
		mnt=/tmp/extroot-vol.$$
		mkdir -p "$mnt"
		mount -t ubifs "$dev" "$mnt" || { rmdir "$mnt"; echo "cannot mount $dev" >&2; return 1; }
		dir="$mnt"
	fi
	mkdir -p "$dir/upper/etc/config"
	[ -f "$dir/upper/etc/config/fstab" ] || cp /rom/etc/config/fstab "$dir/upper/etc/config/fstab" 2>/dev/null || : > "$dir/upper/etc/config/fstab"
	uci -q -c "$dir/upper/etc/config" batch || rc=1
	sync
	[ -n "$mnt" ] && { umount "$mnt"; rmdir "$mnt"; }
	return $rc
}

with_rootfs_data() {
	local dev
	dev="$(rootfs_data_dev)" || { echo "rootfs_data volume not found" >&2; return 1; }
	with_volume_config "$dev"
}

current_overlay_device() {
	mount | awk '$3 == "/overlay" { print $1; exit }'
}


# A partition whose whole disk is in use is not safe to touch: after the disk
# was re-partitioned the kernel can still expose stale partition nodes that now
# overlap a live filesystem, and formatting one of those eats the disk.
parent_busy() {
	local dev="$1" parent
	case "$dev" in
	/dev/sd[a-z][0-9]*) parent="$(echo "$dev" | sed 's/[0-9]*$//')" ;;
	/dev/mmcblk[0-9]p[0-9]*) parent="$(echo "$dev" | sed 's/p[0-9]*$//')" ;;
	*) return 1 ;;
	esac
	mount | grep -q "^$parent " && return 0
	return 1
}

cmd_status() {
	local dev
	dev="$(current_overlay_device)"
	echo "/overlay is on: ${dev:-unknown}"
	df -h /overlay | tail -1
	echo
	echo "configured in fstab:"
	if uci -q get fstab.extroot >/dev/null; then
		local where
		where="$(uci -q get fstab.extroot.device || true)"
		[ -n "$where" ] || where="UUID $(uci -q get fstab.extroot.uuid)"
		echo "  $where"
		echo "  enabled $(uci -q get fstab.extroot.enabled)"
	else
		echo "  no extroot entry"
	fi
}

# A candidate is a whole disk or partition that is not currently mounted and is
# not where the running system lives.
cmd_list() {
	local found=0 d name size model
	for d in /dev/sd[a-z] /dev/sd[a-z][0-9]* /dev/mmcblk[0-9]p[0-9]*; do
		[ -b "$d" ] || continue
		name="$(basename "$d")"
		size="$(awk -v n="$name" '$4 == n { printf "%.1f GB", $3/1024/1024 }' /proc/partitions)"
		model=""
		[ -r "/sys/class/block/$name/device/model" ] && model="$(cat "/sys/class/block/$name/device/model")"
		if mount | grep -q "^$d "; then
			echo "$d  ${size:-?}  $model  (mounted, skipped)"
		elif parent_busy "$d"; then
			echo "$d  ${size:-?}  $model  (whole disk in use, skipped)"
		else
			echo "$d  ${size:-?}  $model"
			found=1
		fi
	done
	[ "$found" = 1 ] || echo "no usable disks found; plug one into the USB port and try again"
}

# Same survey as cmd_list, as JSON, for the LuCI page.
cmd_list_json() {
	local first=1 d name size model mounted
	printf '['
	for d in /dev/sd[a-z] /dev/sd[a-z][0-9]* /dev/mmcblk[0-9]p[0-9]*; do
		[ -b "$d" ] || continue
		name="$(basename "$d")"
		size="$(awk -v n="$name" '$4 == n { printf "%.0f", $3/1024 }' /proc/partitions)"
		model=""
		[ -r "/sys/class/block/$name/device/model" ] && model="$(tr -d '\r' < "/sys/class/block/$name/device/model" | sed 's/[[:space:]]*$//' | sed 's/"/\\"/g')"
		mounted=false
		mount | grep -q "^$d " && mounted=true
		parent_busy "$d" && mounted=true
		[ $first = 1 ] || printf ','
		first=0
		printf '{"device":"%s","size_mb":%s,"model":"%s","mounted":%s}' "$d" "${size:-0}" "$model" "$mounted"
	done
	printf ']\n'
}

cmd_status_json() {
	local dev total avail uuid enabled
	dev="$(current_overlay_device)"
	set -- $(df -k /overlay | tail -1)
	total="$2"; avail="$4"
	uuid="$(uci -q get fstab.extroot.uuid || true)"
	enabled="$(uci -q get fstab.extroot.enabled || true)"
	[ -n "$enabled" ] || enabled=""
	printf '{"device":"%s","total_kb":%s,"available_kb":%s,"extroot_uuid":"%s","extroot_enabled":"%s"}\n' \
		"${dev:-}" "${total:-0}" "${avail:-0}" "$uuid" "$enabled"
}

cmd_use() {
	local dev="$1" yes="$2" do_reboot="$3" uuid
	[ -n "$dev" ] || die "usage: be7000-extroot use <device> [--yes] [--reboot]"
	[ -b "$dev" ] || die "$dev is not a block device"
	mount | grep -q "^$dev " && die "$dev is mounted, unmount it first"
	parent_busy "$dev" && die "the whole disk this partition sits on is mounted, so this node may be stale; unmount it first"
	case "$dev" in
	/dev/ubi*|/dev/mtd*) die "$dev is internal flash, not an external disk" ;;
	esac
	[ "$dev" = "$(current_overlay_device)" ] && die "$dev already carries /overlay"

	if [ "$yes" != 1 ]; then
		echo "This erases everything on $dev and moves /overlay onto it."
		echo "Re-run with --yes to go ahead."
		exit 1
	fi

	command -v mkfs.ext4 >/dev/null || die "mkfs.ext4 is missing"

	echo "Formatting $dev"
	mkfs.ext4 -q -F -L "$LABEL" "$dev"

	mkdir -p "$MNT"
	mount "$dev" "$MNT" || die "cannot mount $dev"

	uuid="$(block info "$dev" 2>/dev/null | sed -n 's/.*UUID="\([^"]*\)".*/\1/p')"
	[ -n "$uuid" ] || die "cannot read the UUID of $dev"

	# Settings first, so the copy on the disk already has its fstab entry.
	uci -q batch <<-EOT
		set fstab.extroot=mount
		set fstab.extroot.target='/overlay'
		set fstab.extroot.uuid='$uuid'
		set fstab.extroot.fstype='ext4'
		set fstab.extroot.options='rw,noatime'
		set fstab.extroot.enabled='1'
		commit fstab
	EOT
	# USB disks need a few seconds to show up in preinit.
	[ "$(uci -q get fstab.@global[0].delay_root)" -ge 15 ] 2>/dev/null || {
		uci -q set fstab.@global[0].delay_root='15' && uci -q commit fstab
	}
	echo "Copying the current overlay across"
	# /overlay holds upper/ and work/; copy the contents, not the mount point.
	cp -a /overlay/. "$MNT"/ 2>/dev/null || true
	mkdir -p "$MNT/upper" "$MNT/work"
	# On the disk bigoverlay must be off, otherwise its boot script reboots to
	# "switch /overlay back" to mtd28. Only there: the internal settings keep
	# whatever the user chose.
	mkdir -p "$MNT/upper/etc/config"
	[ -f "$MNT/upper/etc/config/bigoverlay" ] || cp /rom/etc/config/bigoverlay "$MNT/upper/etc/config/" 2>/dev/null || true
	uci -q -c "$MNT/upper/etc/config" set bigoverlay.main.enabled='0' && uci -q -c "$MNT/upper/etc/config" commit bigoverlay || true
	sync
	umount "$MNT"
	rmdir "$MNT"

	echo "Pointing /overlay at $dev (UUID $uuid)"
	# This is the fstab fstools actually reads at boot. The extroot entry sorts
	# before bigoverlay (UUID against "ubi1_*"), so it wins while the disk is
	# there; without the disk the router boots on the slot's small overlay.
	with_rootfs_data <<-EOT || die "could not write the extroot entry into rootfs_data"
		set fstab.extroot=mount
		set fstab.extroot.target='/overlay'
		set fstab.extroot.uuid='$uuid'
		set fstab.extroot.fstype='ext4'
		set fstab.extroot.options='rw,noatime'
		set fstab.extroot.enabled='1'
		set fstab.@global[0].delay_root='15'
		commit fstab
	EOT

	echo "Done. The change takes effect on the next boot."
	if [ "$do_reboot" = 1 ]; then sync; reboot; fi
}

cmd_revert() {
	local yes="$1" do_reboot="$2"
	uci -q get fstab.extroot >/dev/null || die "no extroot entry to remove"
	if [ "$yes" != 1 ]; then
		echo "This returns /overlay to internal flash. Anything stored on the disk stays there but stops being used."
		echo "Re-run with --yes to go ahead."
		exit 1
	fi
	uci -q delete fstab.extroot
	uci -q commit fstab
	printf 'delete fstab.extroot\ncommit fstab\n' | with_rootfs_data || die "could not remove the extroot entry from rootfs_data"
	# use also wrote the entry into the shared volume on mtd28; when reverting
	# from the disk that volume is not /etc, so clean it here too.
	local vol
	if vol="$(bigoverlay_dev)"; then
		printf 'delete fstab.extroot\ncommit fstab\n' | with_volume_config "$vol" ||
			echo "note: could not clean the settings on $vol" >&2
	fi
	echo "Removed. The change takes effect on the next boot."
	if [ "$do_reboot" = 1 ]; then sync; reboot; fi
}

YES=0
REBOOT=0
ACTION="$1"
[ $# -gt 0 ] && shift
DEV=""
for a in "$@"; do
	case "$a" in
	--yes) YES=1 ;;
	--reboot) REBOOT=1 ;;
	--json) ;;
	*) DEV="$a" ;;
	esac
done

JSON=0
for a in "$@"; do [ "$a" = "--json" ] && JSON=1; done

case "$ACTION" in
status) [ $JSON = 1 ] && cmd_status_json || cmd_status ;;
list)   [ $JSON = 1 ] && cmd_list_json || cmd_list ;;
use)    cmd_use "$DEV" "$YES" "$REBOOT" ;;
revert) cmd_revert "$YES" "$REBOOT" ;;
*)
	echo "usage: be7000-extroot {status|list|use <device> [--yes] [--reboot]|revert [--yes] [--reboot]}"
	exit 1
	;;
esac
