#!/usr/bin/env ucode
// Sends queued alerts to the phones.
// Direct: this router holds an Apple push key (installed with `miwrt-ctl apns`) and talks to Apple itself.
// Relay: a relay that holds the key passes them on.
// Either way the alert's title and text are encrypted here with a key only the phone has. What leaves the
// router readable: the phones' notification addresses, the kind of alert, and a fixed "your router has an alert".
'use strict';
import { readfile, writefile, rename, unlink, chmod, stat } from 'fs';
import * as hub from 'miwrt.hub';

const RUN = '/tmp/miwrt';
const QUEUE = RUN + '/push-queue.jsonl';
const JWT = RUN + '/apns-jwt';
const APP = 'cloud.iroham.miwrt';
const HOSTS = { production: 'api.push.apple.com', sandbox: 'api.sandbox.push.apple.com' };

function tmp(ext) { return `${RUN}/push-${hexenc(hub.random_bytes(6))}.${ext}`; }
function b64url(s) { return replace(replace(replace(b64enc(s), /\+/g, '-'), /\//g, '_'), /=+$/, ''); }

/* The signed token that proves to Apple who is sending. Apple wants it reused, not remade per message:
   it is kept for 50 minutes. */
function provider_token(conf) {
	let st = stat(JWT);
	if (st && time() - st.mtime < 3000) { let t = trim(readfile(JWT) ?? ''); if (length(t) > 100) return t; }
	let signing = b64url(sprintf('%J', { alg: 'ES256', kid: conf.key_id })) + '.' + b64url(sprintf('%J', { iss: conf.team_id, iat: time() }));
	let f = tmp('sig');
	writefile(f, signing);
	// openssl writes the signature as two numbers in a DER wrapper; a token needs them as 2 x 32 raw bytes
	let out = hub.run(`openssl dgst -sha256 -sign ${hub.APNS_KEY} -binary ${f} 2>/dev/null | openssl asn1parse -inform DER 2>/dev/null`);
	unlink(f);
	let raw = '';
	for (let line in split(out, '\n')) {
		let m = match(line, /INTEGER +:([0-9A-Fa-f]+)$/);
		if (!m) continue;
		let h = m[1];
		while (length(h) < 64) h = '0' + h;
		raw += substr(h, length(h) - 64);
	}
	if (length(raw) != 128) return null;
	let token = signing + '.' + b64url(hexdec(raw));
	writefile(JWT, token + '\n');
	chmod(JWT, 0600);
	return token;
}

const GENERIC = { title: 'MiWRT', body: 'Your router has an alert. Open MiWRT to read it.' };

/* AES-256-CBC, then HMAC-SHA256 over iv + ciphertext. Result: base64(iv | ciphertext | mac), or null. */
function encrypt(key, a) {
	if (!match(key ?? '', /^[0-9a-f]{128}$/)) return null;
	let ek = substr(key, 0, 64), mk = substr(key, 64), iv = hexenc(hub.random_bytes(16));
	let base = tmp('e');
	// the time, id and kind travel inside the sealed text, so an old alert cannot be passed off as a new one
	writefile(base + '.pt', sprintf('%J', { t: substr(a.title ?? '', 0, 120), b: substr(a.body ?? '', 0, 400), ts: time(), id: a.id, k: a.kind }));
	writefile(base + '.iv', hexdec(iv));
	let out = trim(hub.run(`openssl enc -aes-256-cbc -K ${ek} -iv ${iv} -in ${base}.pt -out ${base}.ct 2>/dev/null && cat ${base}.iv ${base}.ct | openssl dgst -sha256 -mac HMAC -macopt hexkey:${mk} -binary > ${base}.mac 2>/dev/null && cat ${base}.iv ${base}.ct ${base}.mac | openssl base64 -A 2>/dev/null`));
	for (let x in [ 'pt', 'iv', 'ct', 'mac' ]) unlink(`${base}.${x}`);
	return (length(out) <= 3000 && match(out, /^[A-Za-z0-9+\/=]{88,}$/)) ? out : null;
}

function send_direct(a, targets) {
	let conf;
	try { conf = json(readfile(hub.APNS_CONF)); } catch (e) { return; }
	if (!match(conf.key_id ?? '', /^[A-Z0-9]{10}$/) || !match(conf.team_id ?? '', /^[A-Z0-9]{10}$/)) return;
	let token = provider_token(conf);
	if (!token) return;
	let kind = replace(`${a.kind ?? 'router'}`, /[^A-Za-z0-9_-]/g, '');
	let headf = tmp('hdr'), gone = [];
	writefile(headf, join('\n', [ 'authorization: bearer ' + token, 'apns-topic: ' + (conf.bundle_id ?? APP), 'apns-push-type: alert',
		'apns-priority: ' + (a.severity == 'critical' ? '10' : '5'), 'apns-collapse-id: ' + substr(kind, 0, 32), 'apns-expiration: ' + (time() + 3600) ]) + '\n');
	chmod(headf, 0600);
	for (let t in slice(targets, 0, 20)) {
		if (!match(t.token ?? '', /^[0-9a-f]{64,200}$/) || !HOSTS[t.env]) continue;
		let payload = { aps: { alert: GENERIC, sound: 'default', 'thread-id': kind }, kind: a.kind, alert_id: a.id };
		let enc = encrypt(t.key, a);
		if (enc) { payload.aps['mutable-content'] = 1; payload.enc = enc; }
		let bodyf = tmp('json');
		writefile(bodyf, sprintf('%J', payload));
		let code = trim(hub.run(`curl -sS --http2 --max-time 10 -o /dev/null -w '%{http_code}' -H @${headf} -d @${bodyf} https://${HOSTS[t.env]}/3/device/${t.token} 2>/dev/null`));
		if (code == '410') push(gone, t.token);
		if (code == '403') unlink(JWT);   // Apple refused the token: make a new one next time
		unlink(bodyf);
	}
	unlink(headf);
	if (length(gone)) hub.push_forget(gone);
}

function send_relay(a, targets, relay) {
	let bodyf = tmp('json');
	let messages = [];
	for (let t in slice(targets, 0, 20)) {
		let m = { token: t.token, env: t.env }, enc = encrypt(t.key, a);
		if (enc) m.enc = enc;
		push(messages, m);
	}
	writefile(bodyf, sprintf('%J', { app: APP, messages, kind: a.kind, severity: a.severity, id: a.id }));
	let out = hub.run(`uclient-fetch -q -T 10 -O - --header='Content-Type: application/json' --post-file=${bodyf} '${relay}/v1/push' 2>/dev/null`);
	unlink(bodyf);
	try {
		let r = json(out);
		if (type(r.gone) == 'array' && length(r.gone)) hub.push_forget(r.gone);
	} catch (e) {}
}

let st = hub.settings();
let work = tmp('work');
if (!rename(QUEUE, work)) exit(0);
let lines = filter(split(readfile(work) ?? '', '\n'), l => length(l) > 0);
unlink(work);
let mode = hub.push_mode(st.push);
if (!st.push.enabled || !mode) exit(0);
if (mode == 'relay' && !hub.relay_ok(st.push.relay)) exit(0);
let targets = hub.push_targets();
if (!length(targets)) exit(0);

let sent = 0;
for (let line in lines) {
	let a;
	try { a = json(line); } catch (e) { continue; }
	if (a.severity == 'info' || st.push.kinds[a.kind] === false) continue;
	if (++sent > 20) break;   // a burst of alerts must not become a burst of notifications
	if (mode == 'direct') send_direct(a, targets); else send_relay(a, targets, st.push.relay);
}
