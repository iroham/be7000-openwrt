'use strict';

import { popen } from 'fs';
import { cursor } from 'uci';

const BIN = '/usr/libexec/be7000-leds';

const SOURCES = [ 'service', 'internet', 'command', 'off' ];

function run(args) {
	let fd = popen(`${BIN} ${args} 2>&1`, 'r');
	let out = fd ? trim(fd.read('all') ?? '') : '';
	let rc = fd ? fd.close() : -1;
	return { rc, out };
}

function num(v, def) {
	v = +v;
	return (v >= 50 && v <= 10000) ? v : def;
}

return {
	'be7000-leds': {
		status: {
			call: function() {
				let r = run('status');
				let st;
				try { st = json(r.out); } catch (e) { return { error: r.out }; }
				let sec = cursor().get_all('be7000', 'leds') ?? {};
				st.source = (index(SOURCES, sec.aiot_source) >= 0) ? sec.aiot_source : 'off';
				st.service = sec.aiot_service ?? '';
				st.target = sec.aiot_target ?? '1.1.1.1';
				st.cmd = sec.aiot_cmd ?? '';
				st.show = (sec.aiot_show == 'blink') ? 'blink' : 'on';
				st.invert = (sec.aiot_invert == '1');
				st.on_ms = num(sec.aiot_on_ms, 500);
				st.off_ms = num(sec.aiot_off_ms, 500);
				return st;
			}
		},
		aiot_set: {
			args: { source: '', service: '', target: '', cmd: '', show: '', invert: false, on_ms: 0, off_ms: 0 },
			call: function(req) {
				let a = req.args ?? {};
				if (index(SOURCES, a.source) < 0)
					return { ok: false, output: 'unknown source' };
				if (a.source == 'service' && !match(a.service ?? '', /^[A-Za-z0-9_.@+-]{1,40}$/))
					return { ok: false, output: 'process name is not valid' };
				if (a.source == 'internet' && !match(a.target ?? '', /^[A-Za-z0-9_.:-]{1,253}$/))
					return { ok: false, output: 'host name is not valid' };
				if (a.source == 'command' && (length(a.cmd ?? '') < 1 || length(a.cmd) > 200 || match(a.cmd, /[\n\r]/)))
					return { ok: false, output: 'command is empty, too long or has several lines' };

				let uci = cursor();
				if (uci.get('be7000', 'leds') == null)
					uci.set('be7000', 'leds', 'leds');
				uci.set('be7000', 'leds', 'aiot_source', a.source);
				uci.set('be7000', 'leds', 'aiot_show', a.show == 'blink' ? 'blink' : 'on');
				uci.set('be7000', 'leds', 'aiot_invert', a.invert ? '1' : '0');
				uci.set('be7000', 'leds', 'aiot_on_ms', '' + num(a.on_ms, 500));
				uci.set('be7000', 'leds', 'aiot_off_ms', '' + num(a.off_ms, 500));
				uci.set('be7000', 'leds', 'aiot_service', a.service ?? '');
				uci.set('be7000', 'leds', 'aiot_target', a.target ?? '');
				uci.set('be7000', 'leds', 'aiot_cmd', a.cmd ?? '');
				uci.commit('be7000');
				let r = run('apply');
				return { ok: r.rc == 0, output: r.out };
			}
		}
	}
};
