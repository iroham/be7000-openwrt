+		ret = ipq_pcs_stock_soc_ret;
+		dev_info(qpcs->dev, "stock order: 10G-QXGMII bring-up already done (%d)\n", ret);
+	} else if (qpcs->interface == PHY_INTERFACE_MODE_10G_QXGMII) {
+		ret = 0;
+		dev_info(qpcs->dev, "stock order: 10G-QXGMII already set up by phylink\n");
+	} else {
+		ret = ipq_pcs_early_up(qpcs, false);
+	}
