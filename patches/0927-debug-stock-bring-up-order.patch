+EXPORT_SYMBOL_GPL(ipq_pcs_stock_soc_up);
+
+/**
+ * ipq_pcs_stock_idle_up() - stock order: bring the idle UNIPHY up now
+ *
+ * Called by the QCA8084 driver right after its UQXGMII mode set, or when its
+ * package init ends before that step. Runs the qcom,idle-usxgmii bring-up
+ * that stock_order=0 does at probe, once. A PCS that probes after this call
+ * does it at probe.
+ */
+void ipq_pcs_stock_idle_up(void)
+{
+	struct ipq_pcs *qpcs;
+
+	if (!ipq_pcs_stock())
+		return;
+
+	mutex_lock(&ipq_pcs_stock_lock);
+	ipq_pcs_stock_chip_done = true;
+	qpcs = ipq_pcs_stock_idle;
+	ipq_pcs_stock_idle = NULL;
+	if (qpcs && qpcs->idle_up) {
+		dev_info(qpcs->dev, "stock order: idle UNIPHY already up\n");
+	} else if (qpcs) {
+		dev_info(qpcs->dev, "stock order: idle USXGMII bring-up after the QCA8084 mode set\n");
+		ipq_pcs_idle_up(qpcs);
+	}
+	mutex_unlock(&ipq_pcs_stock_lock);
+}
+EXPORT_SYMBOL_GPL(ipq_pcs_stock_idle_up);
+
+/* stock_order at probe: park the idle bring-up until the chip mode set,
+ * unless that already happened. Returns true when parked.
+ */
+static bool ipq_pcs_stock_defer_idle(struct ipq_pcs *qpcs)
+{
+	bool defer;
+
+	mutex_lock(&ipq_pcs_stock_lock);
+	defer = !ipq_pcs_stock_chip_done;
+	if (defer)
+		ipq_pcs_stock_idle = qpcs;
+	mutex_unlock(&ipq_pcs_stock_lock);
+
+	return defer;
+}
