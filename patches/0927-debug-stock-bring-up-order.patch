 };
 
 #define phylink_pcs_to_qpcs_mii(_pcs)	\
@@ -420,7 +430,6 @@
 
 static int ipq_pcs_config_usxgmii(struct ipq_pcs *qpcs, int index,
 				  phy_interface_t interface);
-int ipq_pcs_debug_recalibrate(void);
 
 /* Experiment (BE7000 dead RX): redo the whole UNIPHY0 10G-QXGMII bring-up,
  * including the PLL reset and with it the analog calibration, at a moment
@@ -664,6 +673,7 @@
 		dev_err(qpcs->dev, "PCS calibration timed-out\n");
 		goto err_clk;
 	}
+	qpcs->cal_done = ktime_get();
 
 	/* Re-enable the port clocks disabled at entry */
 	ret = ipq_pcs_hold_port_clks(qpcs, interface, false);
@@ -778,6 +788,60 @@
 module_param(vendor_order, bool, 0444);
 MODULE_PARM_DESC(vendor_order, "USXGMII/10G-QXGMII UNIPHY bring-up in the SSDK order");
 
+/* Experiment (BE7000 dead RX): the stock bring-up order. The stock firmware
+ * takes the QCA8084 out of reset at MDIO probe, brings UNIPHY0 up in
+ * UQXGMII and sets the chip to UQXGMII right after it in the same call,
+ * then UNIPHY2, and never touches the SoC XPCS again. With stock_order the
+ * early 10G-QXGMII and idle USXGMII bring-ups move from probe to the
+ * QCA8084 mode set (ipq_pcs_stock_soc_up(), ipq_pcs_stock_idle_up()), the
+ * QCA8084 clock controller does not wait for this PCS and holds both chip
+ * SerDes system clocks on (SerDes0 until right after the chip mode set), and
+ * the SoC XPCS redo on first link up is skipped when that bring-up set the
+ * XPCS up. The QCA8084 drivers can only call in when this driver is built
+ * in, so a modular PCS keeps the old order.
+ */
+static bool stock_order = true;
+module_param(stock_order, bool, 0444);
+MODULE_PARM_DESC(stock_order, "bring UNIPHY0/UNIPHY2 up around the QCA8084 mode set as stock does, no SoC XPCS redo after that (built-in PCS only)");
+
+static bool ipq_pcs_stock(void)
+{
+	return IS_BUILTIN(CONFIG_PCS_QCOM_IPQ9574) && stock_order;
+}
+
+/**
+ * ipq_pcs_stock_order() - stock bring-up order selected
+ *
+ * Return: the stock_order module parameter, false if the PCS is a module.
+ */
+bool ipq_pcs_stock_order(void)
+{
+	return ipq_pcs_stock();
+}
+EXPORT_SYMBOL_GPL(ipq_pcs_stock_order);
+
+/* stock_order: the stock bring-ups of UNIPHY0 and UNIPHY2 run under this lock,
+ * with the state further down.
+ */
+static DEFINE_MUTEX(ipq_pcs_stock_lock);
+
+/* The debugfs knobs (ipq_pcs0_ctl, ipq_pcs0_regs, ipq_pcs_idle_ctl) return
+ * -EBUSY while a stock bring-up runs, and no stock bring-up starts while one
+ * of them runs. Without stock_order nothing changes.
+ */
+static int ipq_pcs_dbg_begin(void)
+{
+	if (ipq_pcs_stock() && !mutex_trylock(&ipq_pcs_stock_lock))
+		return -EBUSY;
+	return 0;
+}
+
+static void ipq_pcs_dbg_end(void)
+{
+	if (ipq_pcs_stock())
+		mutex_unlock(&ipq_pcs_stock_lock);
+}
+
 static int ipq_pcs_config_usxgmii(struct ipq_pcs *qpcs,
 				  int index,
 				  phy_interface_t interface)
@@ -801,7 +865,11 @@
 					       val, val & XPCS_KR_LINK_STS,
 					       1000, 100000);
 		qpcs->xpcs_redo = !!ret;
-		if (ret)
+		qpcs->xpcs_stock = qpcs->stock_bringup;
+		if (ret && qpcs->xpcs_stock)
+			dev_info(qpcs->dev,
+				 "10GBASE-R link not up before USXG_EN, the chip is set up next (stock order, no XPCS redo)\n");
+		else if (ret)
 			dev_warn(qpcs->dev,
 				 "10GBASE-R link not up before USXG_EN, will set the XPCS up again on first link up\n");
 		else
@@ -1249,6 +1317,19 @@
 	if (!qpcs->xpcs_redo && !force)
 		goto out;
 
+	/* Stock never resets the SoC XPCS once the chip is up. Only when the
+	 * stock bring-up set the XPCS up; after a phylink bring-up the redo
+	 * runs as before.
+	 */
+	if (!force && qpcs->xpcs_stock) {
+		val = 0;
+		regmap_read(qpcs->regmap, XPCS_KR_STS, &val);
+		qpcs->xpcs_redo = false;
+		dev_info(qpcs->dev, "stock order: SoC XPCS redo skipped (KR_STS1 0x%x)\n",
+			 val);
+		goto out;
+	}
+
 	if (!force) {
 		ret = regmap_read_poll_timeout(qpcs->regmap, XPCS_KR_STS, val,
 					       val & XPCS_KR_LINK_STS,
@@ -1357,6 +1438,7 @@
 
 	ret = regmap_read_poll_timeout(qpcs->regmap, PCS_CALIBRATION, val,
 				       val & PCS_CALIBRATION_DONE, 1000, 100000);
+	qpcs->cal_done = ktime_get();
 	if (ret)
 		dev_warn(qpcs->dev, "vendor order: calibration not done (0x%x), going on as the SSDK does\n", val);
 
@@ -1483,10 +1565,13 @@
 	struct ipq_pcs *qpcs = ipq_pcs_dbg;
 	unsigned int v;
 	u32 a;
-	int i;
+	int i, ret;
 
 	if (!qpcs)
